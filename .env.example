# Copia este archivo como .env y cambia los valores por los tuyos.
# El archivo .env NO se sube a Git.

PORT=3000
NODE_ENV=development

# Cadena de conexion a PostgreSQL
DATABASE_URL="postgresql://postgres:TU_CONTRASENA@localhost:5432/mitienda"

# Texto largo y secreto para firmar los tokens (obligatorio).
# Se puede generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=UNA_CADENA_LARGA_Y_SECRETA

# Cuenta del administrador que crea el seed (la contrasena debe tener minimo 8 caracteres)
ADMIN_EMAIL=admin@mitienda.com
ADMIN_PASSWORD=LA_CONTRASENA_DEL_ADMINISTRADOR

# Opcional: origenes web permitidos por CORS, separados por coma.
# Si se deja vacio, ningun sitio web externo puede llamar a la API.
CORS_ORIGINS=
