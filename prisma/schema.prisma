generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Producto {
  id        Int    @id @default(autoincrement())
  nombre    String
  precio    Int
  categoria String
  stock     Int

  @@map("productos")
}